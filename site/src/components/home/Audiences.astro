---
// Who it's for: one card per audience. The card's `visual` (rank | size | years) picks its coded icon and pills:
// who uses Scorecard, and the industries they work in (July taxonomy). Title, label and link come from the CMS.
const { value: v } = Astro.props;

const P: Record<string, string> = {
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  user: '<circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>',
  map: '<path d="M14.1 5.55a2 2 0 0 0 1.8 0l3.66-1.83A1 1 0 0 1 21 4.62v12.76a1 1 0 0 1-.55.9l-4.55 2.27a2 2 0 0 1-1.8 0l-4.2-2.1a2 2 0 0 0-1.8 0l-3.66 1.83A1 1 0 0 1 3 19.38V6.62a1 1 0 0 1 .55-.9L8.1 3.45a2 2 0 0 1 1.8 0z"/><path d="M15 5.76v15"/><path d="M9 3.24v15"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  package: '<path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><path d="m3.3 7 8.7 5 8.7-5"/>',
  factory: '<path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1M12 18h1M7 18h1"/>',
  wrench: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/>',
  heart: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>',
  truck: '<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>',
  brief: '<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect x="2" y="6" width="20" height="14" rx="2"/>',
  bank: '<path d="M3 22h18M6 18v-7M10 18v-7M14 18v-7M18 18v-7M12 2l8 5H4z"/>',
  code: '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
};
const icon = (k: string) => `<svg class="aud-i" viewBox="0 0 24 24" aria-hidden="true">${P[k] ?? ""}</svg>`;

const CARDS: Record<string, { icon: string; people: string[]; industries: [string, string][] }> = {
  rank: { icon: "users", people: ["Sales leaders", "Account executives", "Founder-led sales"],
    industries: [["Distribution", "package"], ["Manufacturing", "factory"], ["Field services", "wrench"], ["Healthcare", "heart"], ["Logistics", "truck"]] },
  size: { icon: "map", people: ["Founders", "CEOs", "First sales hire"],
    industries: [["Healthcare", "heart"], ["Field services", "wrench"], ["Professional services", "brief"], ["Financial services", "bank"], ["SaaS and technology", "code"]] },
  years: { icon: "mail", people: ["Search funds", "Self-funded searchers", "Independent sponsors"],
    industries: [["Field services", "wrench"], ["Distribution", "package"], ["Healthcare services", "heart"], ["Business services", "brief"], ["Logistics", "truck"]] },
};
---
<section class="jobs aud" id="why"><div class="wrap">
  <h2 class="h2c">{v.heading}</h2>
  <div class="jcols">
    {(v.cards ?? []).map((c: any) => {
      const k = CARDS[c.visual] ?? CARDS.rank;
      return (
    <article class="job">
      <span class="aud-ic" set:html={icon(k.icon)} />
      <span class="who">{c.who}</span>
      <h3>{c.title}</h3>
      <ul class="pills ppl" aria-label="Who uses it">{k.people.map((p) => <li class="pill"><Fragment set:html={icon("user")} />{p}</li>)}</ul>
      <ul class="pills mkt" aria-label="Industries">{k.industries.map(([n, i]) => <li class="pill"><Fragment set:html={icon(i)} />{n}</li>)}</ul>
      <a class="job-cta" href={c.cta_href}>{c.cta_label}</a>
    </article>
      );
    })}
  </div>
</div></section>
