---
import Form from "./Form.astro";

const { value: v } = Astro.props;
const fields = [
	{ name: "search", label: v.query_label, placeholder: v.query_placeholder, rows: 2 },
	{ name: "geography", label: v.geo_label, placeholder: v.geo_placeholder },
	{ name: "fit", label: v.fit_label, placeholder: v.fit_placeholder, rows: 4 },
	{ name: "name", label: v.name_label },
	{ name: "email", label: v.email_label, type: "email" },
	{ name: "company", label: v.company_label, optional: true },
];
---
<section class="challenge chpage" id="top"><div class="wrap">
  <div class="chl">
    <h1>{v.heading}</h1>
    <p>{v.body}</p>
    <ul class="chpts">{(v.points ?? []).map((p: any) => <li><b>{p.title}</b> {p.body}</li>)}</ul>
  </div>
  <Form kind="challenge" fields={fields} v={v} />
  {v.bridge_body && <div class="bridge"><b>{v.bridge_heading}</b> {v.bridge_body}</div>}
</div></section>
