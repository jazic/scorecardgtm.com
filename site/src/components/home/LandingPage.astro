    posthog.init('phc_BsMQ4wmsDxP5ooamuEMVWUSaPakZ3QzkaLTSyVSd62fy', {
        api_host: 'https://us.i.posthog.com',
        defaults: '2026-05-30',
        person_profiles: 'always', // capture all visitors, anonymous included
        session_recording: { maskAllInputs: true }, // don't record text typed into the booking form
    })
  </script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@500;600&family=Caveat:wght@400;500;700&display=swap" rel="stylesheet">
<style is:inline set:html={css}></style>
</head>
<body data-agent="c">

<Nav items={primary?.items ?? []} siteTitle={siteTitle} />

{groups.map((g) => {
	if (g.type === "agents") return <Agents intro={g.intro} agents={g.agents} />;
	const Block = blocks[g.value._type];
	return Block ? <Block value={g.value} /> : null;
})}

<Footer links={footer?.items ?? []} legal={legal?.items ?? []} siteTitle={siteTitle} />

<script is:inline set:html={d3Array}></script>
<script is:inline set:html={logo}></script>
<script is:inline set:html={story}></script>
<script is:inline set:html={jobs}></script>
<script is:inline set:html={score}></script>
<script is:inline set:html={faq}></script>
</body>
</html>
