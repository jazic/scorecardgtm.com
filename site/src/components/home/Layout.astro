    posthog.init('phc_BsMQ4wmsDxP5ooamuEMVWUSaPakZ3QzkaLTSyVSd62fy', {
        api_host: 'https://us.i.posthog.com',
        defaults: '2026-05-30',
        person_profiles: 'always', // capture all visitors, anonymous included
        session_recording: { maskAllInputs: true }, // don't record text typed into the booking form
    })
    // Named events for the conversions we care about (autocapture still records every click).
    addEventListener('click', (e) => {
      const a = e.target.closest && e.target.closest('a[href*="app.scorecardgtm.com/sign-"]');
      if (a) posthog.capture(a.href.includes('/sign-up') ? 'start_trial_click' : 'sign_in_click', { label: a.textContent.trim(), page: location.pathname }, { transport: 'sendBeacon' });
    });
    addEventListener('submit', (e) => {
      const kind = e.target.querySelector && e.target.querySelector('input[name=kind]');
      if (kind) posthog.capture('form_submit', { form: kind.value, page: location.pathname }, { transport: 'sendBeacon' });
    });
  </script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@500;600&family=Caveat:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/site/home.css">
</head>
<body data-agent="c">

<Nav items={primary?.items ?? []} siteTitle={siteTitle} home={home} />

<slot />

<Footer links={footer?.items ?? []} legal={legal?.items ?? []} siteTitle={siteTitle} home={home} />

<script is:inline src="/site/1-d3-array.js"></script>
<script is:inline src="/site/2-logo.js"></script>
{hasAgents ? <>
<script is:inline src="/site/3-story.js"></script>
<script is:inline src="/site/4-jobs.js"></script>
<script is:inline src="/site/5-score.js"></script>
</> : <>
<script is:inline>ScLogo.init(); const navEl = document.querySelector('nav.top'); addEventListener('scroll', () => navEl.classList.toggle('scrolled', scrollY > 8), { passive: true });</script>
</>}
<script is:inline src="/site/6-faq.js"></script>
</body>
</html>
