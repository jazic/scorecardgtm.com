---
import Layout from "./Layout.astro";

// The 404 page body, also rendered by routes that look up content and find nothing.
---
<Layout title="Page not found · Scorecard">
  <section class="prose notfound" id="top"><div class="wrap">
    <span class="who">404</span>
    <h1>We couldn’t find that page.</h1>
    <p class="prose-updated">It may have moved, or the link may be wrong.</p>
    <div class="ctas"><a class="btn btn-coral" href="/">Go to the homepage</a><a class="more" href="/contact">Contact us →</a></div>
  </div></section>
</Layout>
