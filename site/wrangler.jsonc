{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "scorecardgtm",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			// Fresh DB 2026-11-14 (the first one, "scorecardgtm", had the starter schema; kept for rollback).
			"database_name": "scorecardgtm-v2",
			"database_id": "31927595-b9dd-442d-9efd-82ab561af3ca",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "scorecardgtm-media",
		},
	],
	// Cloudflare Email Sending, used by the cloudflareEmail() plugin in astro.config.mjs.
	"send_email": [{ "name": "EMAIL" }],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
